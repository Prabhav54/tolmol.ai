# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the session pooler (port 5432) locally; on Vercel prefer the transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Google AI Studio key (Gemini embeddings + generation). GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=

# Optional: Hugging Face token, needed only when LLM_PROVIDER=huggingface (LLaMA-3).
HUGGINGFACE_API_TOKEN=

# Optional overrides
# LLM_PROVIDER=gemini            # or huggingface
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# EMBEDDING_DIM=768
# SEMANTIC_MIN_SIMILARITY=0.3
# AUTO_INIT_DB=true              # set false on Vercel; run `python -m scripts.init_db` once instead
