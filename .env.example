# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the session pooler (port 5432) locally; on Vercel prefer the transaction pooler (port 6543).
# Local Docker (docker compose up -d): postgresql://user:password@localhost:5433/ecommerce_rag
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Google AI Studio key: Gemini search grounding, chat answers, photo search and embeddings.
# GEMINI_API_KEY is accepted as an alias. Without it, link comparison falls back to the pasted store only.
GOOGLE_API_KEY=

# Optional: Hugging Face token, needed only when LLM_PROVIDER=huggingface (LLaMA-3).
HUGGINGFACE_API_TOKEN=

# Operator endpoints (/api/admin/*). Any long random string; admin routes are disabled when unset.
ADMIN_TOKEN=

# Daily price refresh (Vercel Cron calls /api/cron/refresh with "Authorization: Bearer $CRON_SECRET").
CRON_SECRET=

# Optional: Resend API key for price-drop alert emails.
RESEND_API_KEY=
# ALERT_FROM_EMAIL=tolmol.ai <alerts@your-domain.com>
# PUBLIC_BASE_URL=https://your-app.vercel.app

# Optional overrides
# AUTO_INIT_DB=true              # set false on Vercel; call POST /api/admin/setup once instead
# LLM_PROVIDER=gemini            # or huggingface
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_SEARCH_MODEL=gemini-2.5-flash
# EMBEDDING_DIM=768
# COMPARE_CACHE_HOURS=6
# ANON_HOURLY_LIMIT=30
# CRON_BATCH=3
